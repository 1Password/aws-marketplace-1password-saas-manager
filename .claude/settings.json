{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "disableBypassPermissionsMode": "disable",
    "deny": [
      "WebFetch",
      "WebSearch",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(nc *)",
      "Bash(ncat *)",
      "Bash(telnet *)",
      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(sftp *)",
      "Bash(rsync *)",
      "Bash(ftp *)",
      "Bash(aws *)",
      "Bash(gh *)",
      "Bash(git push *)",
      "Bash(npm publish *)",
      "Bash(python -c *)",
      "Bash(python3 -c *)",
      "Bash(node -e *)",
      "Bash(node --eval *)",
      "Bash(osascript *)",
      "Bash(security *)",
      "Bash(op *)",
      "Bash(printenv)",
      "Bash(printenv *)",
      "Bash(env)",
      "Read(./config/discovery-credentials.json)",
      "Read(./.env)",
      "Edit(./.env)",
      "Edit(./config/discovery-credentials.json)",
      "Bash(cat .env)",
      "Bash(cat ./.env)",
      "Bash(head .env)",
      "Bash(tail .env)",
      "Bash(less .env)",
      "Bash(more .env)",
      "Bash(grep * .env)",
      "Bash(source .env)",
      "Bash(cat config/discovery-credentials.json)",
      "Bash(cat ./config/discovery-credentials.json)",
      "Read(~/.aws/**)",
      "Edit(~/.aws/**)",
      "Bash(cat ~/.aws/*)"
    ]
  }
}
